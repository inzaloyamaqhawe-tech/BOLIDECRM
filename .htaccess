Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteBase /crm/

# Sign-in requires HTTPS because session cookies are secure.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://bolide.co.za%{REQUEST_URI} [R=302,L]

RewriteRule ^api/ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]
